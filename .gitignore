*.zip
logs/**/tb/
logs/**/*.tfevents.*

# 但保留评估曲线和文本日志（小，便于复盘实验）
!logs/**/evaluations.npz
!logs/**/train.log
!models/**/config.json
!models/**/latest.txt
!models/**/eval_summary.csv

